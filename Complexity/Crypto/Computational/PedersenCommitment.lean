/-!
# Pedersen commitments over a prime-order group family

Over a `PrimeOrderGroupFamily`, Pedersen's commitment scheme ([Pedersen1991], Section 3;
[BonehShoup2023], Chapter 19) uses a group description `d` and a public commitment key
`h = α • g : F.Carrier d` generated by a secret exponent `α : ZMod (F.order d)`. To commit to a
message `m : ZMod (F.order d)` with randomness `r : ZMod (F.order d)`, the committer computes

`pedersenCommit d h m r = m • g + r • h`.

On encoded group elements and natural-number exponents, `encodePedersenCommit` computes
`F.encode d (F.pedersenCommit d h m r)` in polynomial time from `(d, encode h, m, r)` using
`F.encode d (F.generator d)`, `F.smul`, and `F.add`.

This module establishes:

1. **Algebraic and homomorphic laws (`pedersenCommit_zero`, `pedersenCommit_add`,
   `pedersenCommit_neg`, `pedersenCommit_sub`, `pedersenCommit_smul`)** and polynomial-time
   encoded evaluation (`encodePedersenCommit`, `encodePedersenCommit_encode`,
   `computableInPolyTime_encodePedersenCommit`).
2. **Unconditional hiding (`pedersenCommitLaw_eq_uniform_of_ne_zero`,
   `pedersenCommitLaw_eq_of_ne_zero`, `pedersenHidingForKey_eq_of_ne_zero`,
   `advantage_pedersenHidingGame_le`, `negligible_advantage_pedersenHidingGame`)**: for every
   non-identity commitment key `h ≠ 0`, a uniform blinding exponent
   `r ← PMF.uniformOfFintype (ZMod (F.order d))` makes `pedersenCommit d h m r` uniformly
   distributed on `F.Carrier d` and independent of `m`. Consequently, at any fixed `d` and `h ≠ 0`,
   the chosen-message hiding distributions for `bit = false` and `bit = true` are identical against
   every (even computationally unbounded) two-stage adversary `PedersenHidingAdversary`. When the
   key exponent `α ← PMF.uniformOfFintype (ZMod (F.order d))` is drawn uniformly from all of
   `ZMod (F.order d)` (matching `discreteLogGame`), the degenerate key `α = 0` occurs with
   probability `1 / F.order d`, bounding any unbounded adversary's hiding advantage by `1 / m`
   whenever supported groups have order at least `m`.
3. **Computational binding under the discrete-logarithm assumption (`pedersenBindingGame`,
   `pedersenExtractNat`, `pedersenToDLAdversary`,
   `succProbability_pedersenBindingGame_le_discreteLogGame`, `isPPTOn_pedersenToDLAdversary`,
   `DiscreteLog.pedersenBinding`)**: any double opening `((m₀, r₀), (m₁, r₁))` with
   `(ofBits m₀ : ZMod q) ≠ (ofBits m₁ : ZMod q)` and equal commitments under `h = α • g` forces
   `(ofBits r₀ : ZMod q) ≠ (ofBits r₁ : ZMod q)` and yields
   `α = (r₁ - r₀)⁻¹ * (m₀ - m₁)` modulo `q`, computed in polynomial time via Fermat's little
   theorem (`pedersenExtractNat`). This gives an exact zero-loss reduction from
   `pedersenBindingGame` to `discreteLogGame`.

## Main definitions

* `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommit`,
  `Cslib.Crypto.PrimeOrderGroupFamily.encodePedersenCommit`: algebraic and encoded Pedersen
  commitment evaluation.
* `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommitLaw`: the commitment distribution for a uniform
  blinding exponent `r : ZMod (F.order d)`.
* `Cslib.Crypto.PrimeOrderGroupFamily.PedersenHidingAdversary`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenHidingForKey`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenHidingGame`: two-stage chosen-message hiding
  adversary and experiments.
* `Cslib.Crypto.PrimeOrderGroupFamily.pedersenBindingGame`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenExtractNat`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenToDLAdversary`: computational binding experiment and
  discrete-logarithm extractor.

## Main results

* `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommit_add`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommit_smul`,
  `Cslib.Crypto.PrimeOrderGroupFamily.encodePedersenCommit_encode`,
  `Cslib.Crypto.PrimeOrderGroupFamily.computableInPolyTime_encodePedersenCommit`: homomorphic laws
  and polynomial-time encoded commitment evaluation.
* `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommitLaw_eq_uniform_of_ne_zero`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenCommitLaw_eq_of_ne_zero`,
  `Cslib.Crypto.PrimeOrderGroupFamily.pedersenHidingForKey_eq_of_ne_zero`,
  `Cslib.Crypto.PrimeOrderGroupFamily.advantage_pedersenHidingGame_le`,
  `Cslib.Crypto.PrimeOrderGroupFamily.negligible_advantage_pedersenHidingGame`: perfect hiding for
  `h ≠ 0` and unconditional `1 / m` hiding bound over uniform `α : ZMod (F.order d)`.
* `Cslib.Crypto.PrimeOrderGroupFamily.succProbability_pedersenBindingGame_le_discreteLogGame`,
  `Cslib.Crypto.PrimeOrderGroupFamily.isPPTOn_pedersenToDLAdversary`,
  `Cslib.Crypto.PrimeOrderGroupFamily.DiscreteLog.pedersenBinding`: computational binding under the
  discrete-logarithm assumption.

## References

* [T. P. Pedersen, *Non-Interactive and Information-Theoretic Secure Verifiable Secret
  Sharing*][Pedersen1991], Section 3.
* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*,
  Version 0.6][BonehShoup2023], Chapter 19.
-/

@[expose] public section

namespace Cslib.Crypto.PrimeOrderGroupFamily

open Probability Turing.MultiTapeTM
open scoped ENNReal NNReal

variable (F : PrimeOrderGroupFamily)

/-! ### Algebraic and encoded Pedersen commitments -/

/-- Algebraic Pedersen commitment ([Pedersen1991], Section 3): commit to message
`m : ZMod (F.order d)` with randomness `r : ZMod (F.order d)` under commitment key
`h : F.Carrier d` as `m • g + r • h`. -/
def pedersenCommit (d : F.Desc) (h : F.Carrier d) (m r : ZMod (F.order d)) : F.Carrier d :=
  m • F.generator d + r • h

@[simp]
theorem pedersenCommit_zero (d : F.Desc) (h : F.Carrier d) :
    F.pedersenCommit d h 0 0 = 0 := by
  simp [pedersenCommit]

/-- **Additive homomorphism of Pedersen commitments**: committing to `(m₁ + m₂, r₁ + r₂)` equals
the sum of the individual commitments. -/
theorem pedersenCommit_add (d : F.Desc) (h : F.Carrier d) (m₁ r₁ m₂ r₂ : ZMod (F.order d)) :
    F.pedersenCommit d h (m₁ + m₂) (r₁ + r₂) =
      F.pedersenCommit d h m₁ r₁ + F.pedersenCommit d h m₂ r₂ := by
  simp only [pedersenCommit, add_smul]
  abel

theorem pedersenCommit_neg (d : F.Desc) (h : F.Carrier d) (m r : ZMod (F.order d)) :
    F.pedersenCommit d h (-m) (-r) = -F.pedersenCommit d h m r := by
  simp only [pedersenCommit, neg_smul, neg_add_rev]
  abel

theorem pedersenCommit_sub (d : F.Desc) (h : F.Carrier d) (m₁ r₁ m₂ r₂ : ZMod (F.order d)) :
    F.pedersenCommit d h (m₁ - m₂) (r₁ - r₂) =
      F.pedersenCommit d h m₁ r₁ - F.pedersenCommit d h m₂ r₂ := by
  simp only [pedersenCommit, sub_smul]
  abel

/-- **Scalar-multiplication homomorphism of Pedersen commitments**. -/
theorem pedersenCommit_smul (d : F.Desc) (h : F.Carrier d) (c m r : ZMod (F.order d)) :
    F.pedersenCommit d h (c * m) (c * r) = c • F.pedersenCommit d h m r := by
  simp only [pedersenCommit, smul_add, mul_smul]

/-- Under a commitment key `h = α • g`, `pedersenCommit d (α • g) m r = (m + r * α) • g`. -/
theorem pedersenCommit_smul_generator (d : F.Desc) (α m r : ZMod (F.order d)) :
    F.pedersenCommit d (α • F.generator d) m r = (m + r * α) • F.generator d := by
  simp only [pedersenCommit, smul_smul, ← add_smul]

/-- Two openings `(m₀, r₀)` and `(m₁, r₁)` produce the same commitment under `h = α • g` if and
only if `m₀ + r₀ * α = m₁ + r₁ * α` in `ZMod (F.order d)`. -/
theorem pedersenCommit_smul_generator_eq_iff (d : F.Desc) (α m₀ r₀ m₁ r₁ : ZMod (F.order d)) :
    F.pedersenCommit d (α • F.generator d) m₀ r₀ =
      F.pedersenCommit d (α • F.generator d) m₁ r₁ ↔
      m₀ + r₀ * α = m₁ + r₁ * α := by
  rw [pedersenCommit_smul_generator, pedersenCommit_smul_generator]
  exact (F.smul_generator_injective d).eq_iff

/-- Pedersen commitment on encoded group elements: given `(d, encode h, m, r)`, compute
`encode (m • g + r • h)`. -/
def encodePedersenCommit (input : F.Desc × List Bool × ℕ × ℕ) : List Bool :=
  F.add (input.1,
    F.smul (input.1, input.2.2.1, F.encode input.1 (F.generator input.1)),
    F.smul (input.1, input.2.2.2, input.2.1))

/-- `encodePedersenCommit` computes `F.encode d (F.pedersenCommit d h m r)` on encoded group
elements. -/
@[simp]
theorem encodePedersenCommit_encode (d : F.Desc) (h : F.Carrier d) (m r : ℕ) :
    F.encodePedersenCommit (d, F.encode d h, m, r) =
      F.encode d (F.pedersenCommit d h m r) := by
  simp only [encodePedersenCommit, pedersenCommit, F.smul_encode, F.add_encode]

/-- Encoded Pedersen commitment evaluation is computable in polynomial time. -/
theorem computableInPolyTime_encodePedersenCommit :
    ComputableInPolyTime F.encodePedersenCommit
      (encPair F.encDesc (encPair encBits (encPair encNat encNat))) encBits := by
  have hgen := F.computableInPolyTime_generator.tidy
  have hsmul := F.computableInPolyTime_smul.tidy
  have hadd := F.computableInPolyTime_add.tidy
  unfold encodePedersenCommit
  polytime

/-! ### Unconditional hiding of Pedersen commitments -/

/-- The distribution of `F.pedersenCommit d h m r` when `r` is drawn uniformly from
`ZMod (F.order d)`. -/
noncomputable def pedersenCommitLaw (d : F.Desc) (h : F.Carrier d) (m : ZMod (F.order d)) :
    PMF (F.Carrier d) :=
  (PMF.uniformOfFintype (ZMod (F.order d))).map (F.pedersenCommit d h m)

/-- **Perfect hiding for any non-identity commitment key `h ≠ 0`**: for every message
`m : ZMod (F.order d)`, `F.pedersenCommitLaw d h m` equals the uniform distribution
`(PMF.uniformOfFintype (ZMod (F.order d))).map (· • F.generator d)` on `F.Carrier d`. -/
theorem pedersenCommitLaw_eq_uniform_of_ne_zero (d : F.Desc) {h : F.Carrier d} (hh : h ≠ 0)
    (m : ZMod (F.order d)) :
    F.pedersenCommitLaw d h m =
      (PMF.uniformOfFintype (ZMod (F.order d))).map (· • F.generator d) := by
  obtain ⟨α, rfl⟩ := F.smul_generator_surjective d h
  have hα : α ≠ 0 := by
    rintro rfl
    exact hh (zero_smul _ _)
  let e : ZMod (F.order d) ≃ ZMod (F.order d) :=
    (Equiv.mulRight₀ α hα).trans (Equiv.addLeft m)
  have hcomp : F.pedersenCommit d (α • F.generator d) m =
      (fun γ : ZMod (F.order d) => γ • F.generator d) ∘ e := by
    funext r
    simp [e, pedersenCommit_smul_generator]
  rw [pedersenCommitLaw, hcomp, ← PMF.map_comp, PMF.uniformOfFintype_map_equiv]

/-- **Perfect hiding**: for any `h ≠ 0` and any two messages `m₀, m₁ : ZMod (F.order d)`, the
commitment distributions `F.pedersenCommitLaw d h m₀` and `F.pedersenCommitLaw d h m₁` are
identical. -/
theorem pedersenCommitLaw_eq_of_ne_zero (d : F.Desc) {h : F.Carrier d} (hh : h ≠ 0)
    (m₀ m₁ : ZMod (F.order d)) :
    F.pedersenCommitLaw d h m₀ = F.pedersenCommitLaw d h m₁ := by
  rw [F.pedersenCommitLaw_eq_uniform_of_ne_zero d hh m₀,
    F.pedersenCommitLaw_eq_uniform_of_ne_zero d hh m₁]

/-- Bind form of `pedersenCommitLaw_eq_uniform_of_ne_zero`: for any `h ≠ 0` and message `m`,
sampling `r ← PMF.uniformOfFintype (ZMod (F.order d))` and passing `F.pedersenCommit d h m r` to a
continuation `f` has the same distribution as sampling `γ ← PMF.uniformOfFintype (ZMod (F.order d))`
and passing `γ • F.generator d`. -/
theorem uniform_pedersenCommit {β : Type*} (d : F.Desc) {h : F.Carrier d} (hh : h ≠ 0)
    (m : ZMod (F.order d)) (f : F.Carrier d → PMF β) :
    ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun r => f (F.pedersenCommit d h m r)) =
      (PMF.uniformOfFintype (ZMod (F.order d))).bind fun γ => f (γ • F.generator d) := by
  have hmap := congrArg (fun p => p.bind f) (F.pedersenCommitLaw_eq_uniform_of_ne_zero d hh m)
  simpa only [pedersenCommitLaw, PMF.bind_map, Function.comp_def] using hmap

/-- A two-stage chosen-message hiding adversary against Pedersen commitments:
1. `choose` receives the security parameter `n` and `(d, encode h)` and outputs two candidate
   message words `(m₀, m₁)` together with a saved state word `st`.
2. `guess` receives `n` and `(st, encode c)` and outputs a guess bit. -/
structure PedersenHidingAdversary where
  /-- First stage: choose `((m₀, m₁), st)` from `(d, encode h)`. -/
  choose : ℕ → F.Desc × List Bool → ProbComp ((List Bool × List Bool) × List Bool)
  /-- Second stage: output a guess bit from `(st, encode c)`. -/
  guess : ℕ → List Bool × List Bool → ProbComp Bool

/-- The chosen-message hiding experiment at a fixed group description `d` and commitment key
`h : F.Carrier d` for hidden bit `bit : Bool`. -/
noncomputable def pedersenHidingForKey (d : F.Desc) (h : F.Carrier d)
    (adversary : F.PedersenHidingAdversary) (bit : Bool) (n : ℕ) : Game := do
  let choice ← ProbComp.eval (adversary.choose n (d, F.encode d h))
  let msg := if bit then choice.1.2 else choice.1.1
  let r ← PMF.uniformOfFintype (ZMod (F.order d))
  ProbComp.eval (adversary.guess n
    (choice.2, F.encode d (F.pedersenCommit d h (ofBits msg) r)))

/-- For any non-identity commitment key `h ≠ 0`, `pedersenHidingForKey` produces the exact same
output distribution for any two hidden bits `b₁` and `b₂`, against every (even computationally
unbounded) `PedersenHidingAdversary`. -/
theorem pedersenHidingForKey_eq_of_ne_zero (d : F.Desc) {h : F.Carrier d} (hh : h ≠ 0)
    (adversary : F.PedersenHidingAdversary) (b₁ b₂ : Bool) (n : ℕ) :
    F.pedersenHidingForKey d h adversary b₁ n = F.pedersenHidingForKey d h adversary b₂ n := by
  simp only [pedersenHidingForKey, PMF.monad_bind_eq_bind]
  congr 1; funext choice
  exact (F.uniform_pedersenCommit d hh _
    (fun c => ProbComp.eval (adversary.guess n (choice.2, F.encode d c)))).trans
    (F.uniform_pedersenCommit d hh _
      (fun c => ProbComp.eval (adversary.guess n (choice.2, F.encode d c)))).symm

/-- At any non-identity commitment key `h ≠ 0`, the hiding advantage of any (computationally
unbounded) adversary between `bit = false` and `bit = true` is `0`. -/
@[simp]
theorem advantage_pedersenHidingForKey_eq_zero (d : F.Desc) {h : F.Carrier d} (hh : h ≠ 0)
    (adversary : F.PedersenHidingAdversary) (n : ℕ) :
    Game.advantage (F.pedersenHidingForKey d h adversary false n)
      (F.pedersenHidingForKey d h adversary true n) = 0 := by
  rw [F.pedersenHidingForKey_eq_of_ne_zero d hh adversary false true n, Game.advantage_self]

/-- The full Pedersen chosen-message hiding experiment: draw `d ← setup n` and a uniform key
exponent `α ← PMF.uniformOfFintype (ZMod (F.order d))`, set `h = α • g`, and run
`pedersenHidingForKey`. -/
noncomputable def pedersenHidingGame (setup : ℕ → PMF F.Desc)
    (adversary : F.PedersenHidingAdversary) (bit : Bool) (n : ℕ) : Game := do
  let d ← setup n
  let α ← PMF.uniformOfFintype (ZMod (F.order d))
  F.pedersenHidingForKey d (α • F.generator d) adversary bit n

/-- When every supported group at parameter `n` has order at least `m`, changing the hidden bit from
`b₁` to `b₂` changes acceptance probability in `pedersenHidingGame` by at most `1 / m` (arising
solely from the `1 / F.order d` probability of sampling the degenerate key `α = 0`). -/
theorem pedersenHidingGame_apply_true_le (setup : ℕ → PMF F.Desc)
    (adversary : F.PedersenHidingAdversary) (b₁ b₂ : Bool) (n m : ℕ)
    (hm : ∀ d ∈ (setup n).support, m ≤ F.order d) :
    F.pedersenHidingGame setup adversary b₁ n true ≤
      F.pedersenHidingGame setup adversary b₂ n true + (m : ℝ≥0∞)⁻¹ := by
  have hd_bound (d : F.Desc) (hd : d ∈ (setup n).support) :
      ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun α =>
        F.pedersenHidingForKey d (α • F.generator d) adversary b₁ n) true ≤
      ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun α =>
        F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n) true + (m : ℝ≥0∞)⁻¹ := by
    have hord : (F.order d : ℝ≥0∞)⁻¹ ≤ (m : ℝ≥0∞)⁻¹ :=
      ENNReal.inv_le_inv.mpr (Nat.cast_le.mpr (hm d hd))
    have hα (α : ZMod (F.order d)) :
        PMF.uniformOfFintype (ZMod (F.order d)) α *
          F.pedersenHidingForKey d (α • F.generator d) adversary b₁ n true ≤
        PMF.uniformOfFintype (ZMod (F.order d)) α *
          F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n true +
          if α = 0 then (F.order d : ℝ≥0∞)⁻¹ else 0 := by
      by_cases h0 : α = 0
      · subst h0
        simp only [↓reduceIte, PMF.uniformOfFintype_apply, ZMod.card]
        calc (F.order d : ℝ≥0∞)⁻¹ *
              F.pedersenHidingForKey d ((0 : ZMod (F.order d)) • F.generator d) adversary b₁ n true
            ≤ (F.order d : ℝ≥0∞)⁻¹ * 1 :=
              mul_le_mul_of_nonneg_left (PMF.coe_le_one _ _) zero_le
          _ = 0 + (F.order d : ℝ≥0∞)⁻¹ := by rw [mul_one, zero_add]
          _ ≤ (F.order d : ℝ≥0∞)⁻¹ *
                F.pedersenHidingForKey d ((0 : ZMod (F.order d)) • F.generator d)
                  adversary b₂ n true +
              (F.order d : ℝ≥0∞)⁻¹ := add_le_add zero_le le_rfl
      · have hh : α • F.generator d ≠ 0 := fun h =>
          h0 (F.smul_generator_injective d (by simpa using h))
        simp only [h0, ↓reduceIte, add_zero,
          F.pedersenHidingForKey_eq_of_ne_zero d hh adversary b₁ b₂ n, le_rfl]
    rw [PMF.bind_apply, PMF.bind_apply]
    calc ∑' α, PMF.uniformOfFintype (ZMod (F.order d)) α *
            F.pedersenHidingForKey d (α • F.generator d) adversary b₁ n true
        ≤ ∑' α, (PMF.uniformOfFintype (ZMod (F.order d)) α *
            F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n true +
            if α = 0 then (F.order d : ℝ≥0∞)⁻¹ else 0) :=
          ENNReal.tsum_le_tsum hα
      _ = (∑' α, PMF.uniformOfFintype (ZMod (F.order d)) α *
            F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n true) +
          (F.order d : ℝ≥0∞)⁻¹ := by
          rw [ENNReal.tsum_add, tsum_ite_eq]
      _ ≤ (∑' α, PMF.uniformOfFintype (ZMod (F.order d)) α *
            F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n true) +
          (m : ℝ≥0∞)⁻¹ := add_le_add le_rfl hord
  simp only [pedersenHidingGame, PMF.monad_bind_eq_bind]
  rw [PMF.bind_apply, PMF.bind_apply]
  calc ∑' d, setup n d *
          ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun α =>
            F.pedersenHidingForKey d (α • F.generator d) adversary b₁ n) true
      ≤ ∑' d, setup n d *
          (((PMF.uniformOfFintype (ZMod (F.order d))).bind fun α =>
            F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n) true + (m : ℝ≥0∞)⁻¹) := by
        refine ENNReal.tsum_le_tsum fun d => ?_
        by_cases hd : d ∈ (setup n).support
        · exact mul_le_mul_of_nonneg_left (hd_bound d hd) zero_le
        · have hd0 : setup n d = 0 := by rwa [PMF.mem_support_iff, not_not] at hd
          simp [hd0]
    _ = (∑' d, setup n d *
          ((PMF.uniformOfFintype (ZMod (F.order d))).bind fun α =>
            F.pedersenHidingForKey d (α • F.generator d) adversary b₂ n) true) +
        (m : ℝ≥0∞)⁻¹ := by
        simp only [mul_add, ENNReal.tsum_add, ENNReal.tsum_mul_right, (setup n).tsum_coe, one_mul]

/-- **Unconditional hiding bound for `pedersenHidingGame`**: when every supported group at
parameter `n` has order at least `m > 0`, any (even computationally unbounded)
`PedersenHidingAdversary` has distinguishing advantage at most `1 / m`. -/
theorem advantage_pedersenHidingGame_le (setup : ℕ → PMF F.Desc)
    (adversary : F.PedersenHidingAdversary) (n m : ℕ)
    (hm0 : 0 < m) (hm : ∀ d ∈ (setup n).support, m ≤ F.order d) :
    Game.advantage (F.pedersenHidingGame setup adversary false n)
      (F.pedersenHidingGame setup adversary true n) ≤ 1 / m := by
  have hB : (m : ℝ≥0∞)⁻¹ ≠ ⊤ := ENNReal.inv_ne_top.mpr (Nat.cast_ne_zero.mpr hm0.ne')
  have hadv := Game.advantage_le_of_apply_le hB
    (F.pedersenHidingGame_apply_true_le setup adversary false true n m hm)
    (F.pedersenHidingGame_apply_true_le setup adversary true false n m hm)
  rw [← NNReal.coe_le_coe]
  simpa only [one_div, NNReal.coe_inv, NNReal.coe_natCast, ENNReal.toReal_inv,
    ENNReal.toReal_natCast] using hadv

/-- **Asymptotic unconditional hiding of Pedersen commitments**: when every supported group at
parameter `n` has order at least `m n > 0` and `1 / m n` is negligible, every (even
computationally unbounded) `PedersenHidingAdversary` has negligible advantage in
`pedersenHidingGame`. -/
theorem negligible_advantage_pedersenHidingGame (setup : ℕ → PMF F.Desc)
    (adversary : F.PedersenHidingAdversary)
    {m : ℕ → ℕ} (hm0 : ∀ n, 0 < m n) (hm : ∀ n, ∀ d ∈ (setup n).support, m n ≤ F.order d)
    (hinv : Negligible fun n => (1 / m n : ℝ≥0)) :
    Negligible fun n =>
      Game.advantage (F.pedersenHidingGame setup adversary false n)
        (F.pedersenHidingGame setup adversary true n) :=
  negligible_of_le hinv fun n =>
    F.advantage_pedersenHidingGame_le setup adversary n (m n) (hm0 n) (hm n)

/-! ### Computational binding under the discrete-logarithm assumption -/

/-- `F.Carrier d` has decidable equality via the injective encoding `F.encode d`. -/
instance instDecidableEqCarrier (d : F.Desc) : DecidableEq (F.Carrier d) :=
  (F.encode_injective d).decidableEq

/-- Boolean predicate checking whether two candidate openings `((m₀, r₀), (m₁, r₁))` form a valid
Pedersen commitment collision under `(d, h)`: the messages are distinct modulo `F.order d` and
produce the same commitment in `F.Carrier d`. -/
def checkPedersenCollision (d : F.Desc) (h : F.Carrier d)
    (openings : (List Bool × List Bool) × (List Bool × List Bool)) : Bool :=
  decide ((ofBits openings.1.1 : ZMod (F.order d)) ≠ (ofBits openings.2.1 : ZMod (F.order d))) &&
    decide (F.pedersenCommit d h (ofBits openings.1.1) (ofBits openings.1.2) =
      F.pedersenCommit d h (ofBits openings.2.1) (ofBits openings.2.2))

/-- The Pedersen commitment binding experiment ([Pedersen1991], Section 3): draw `d ← setup n` and
a uniform `α ← PMF.uniformOfFintype (ZMod (F.order d))`, give the adversary `(d, encode (α • g))`,
and accept when the adversary outputs two openings `((m₀, r₀), (m₁, r₁))` satisfying
`checkPedersenCollision d (α • g)`. -/
noncomputable def pedersenBindingGame (setup : ℕ → PMF F.Desc)
    (adversary : ℕ → F.Desc × List Bool →
      ProbComp ((List Bool × List Bool) × (List Bool × List Bool)))
    (n : ℕ) : Game := do
  let d ← setup n
  let α ← PMF.uniformOfFintype (ZMod (F.order d))
  let openings ← ProbComp.eval (adversary n (d, F.encode d (α • F.generator d)))
  return F.checkPedersenCollision d (α • F.generator d) openings

/-- Extract the discrete logarithm `(r₁ - r₀)⁻¹ * (m₀ - m₁) mod q` from a Pedersen commitment
collision `((m₀, r₀), (m₁, r₁))`, computing the modular inverse via Fermat's little theorem as a
`(q - 2)`-th power. -/
def pedersenExtractNat (q m₀ r₀ m₁ r₁ : ℕ) : ℕ :=
  ((r₁ % q + q - r₀ % q) % q) ^ (q - 2) % q * ((m₀ % q + q - m₁ % q) % q) % q

/-- Fermat's little theorem gives the modular inverse in `pedersenExtractNat` whenever
`(r₁ : ZMod q) ≠ (r₀ : ZMod q)`. -/
theorem pedersenExtractNat_cast {q : ℕ} [Fact q.Prime] {m₀ r₀ m₁ r₁ : ℕ}
    (hr : (r₁ : ZMod q) ≠ r₀) :
    (pedersenExtractNat q m₀ r₀ m₁ r₁ : ZMod q) =
      ((r₁ : ZMod q) - r₀)⁻¹ * ((m₀ : ZMod q) - m₁) := by
  have hsub (a b : ℕ) : (((a % q + q - b % q) % q : ℕ) : ZMod q) = (a : ZMod q) - b := by
    rw [ZMod.natCast_mod, Nat.cast_sub ((Nat.mod_lt _ (Fact.out : q.Prime).pos).le.trans
      (Nat.le_add_left _ _)), Nat.cast_add, ZMod.natCast_mod, ZMod.natCast_mod, ZMod.natCast_self,
      add_zero]
  have hne : (r₁ : ZMod q) - r₀ ≠ 0 := sub_ne_zero.mpr hr
  have hinv : ((r₁ : ZMod q) - r₀) ^ (q - 2) = ((r₁ : ZMod q) - r₀)⁻¹ :=
    ZMod.pow_card_sub_two_eq_inv hne
  simp only [pedersenExtractNat, Nat.cast_mul, ZMod.natCast_mod, Nat.cast_pow, hsub, hinv]

/-- Any valid Pedersen collision under `h = α • g` recovers `α` via `pedersenExtractNat`. -/
theorem pedersenExtractNat_eq_of_checkPedersenCollision (d : F.Desc) (α : ZMod (F.order d))
    {openings : (List Bool × List Bool) × (List Bool × List Bool)}
    (hcoll : F.checkPedersenCollision d (α • F.generator d) openings = true) :
    (pedersenExtractNat (F.order d)
      (ofBits openings.1.1) (ofBits openings.1.2)
      (ofBits openings.2.1) (ofBits openings.2.2) : ZMod (F.order d)) = α := by
  simp only [checkPedersenCollision, Bool.and_eq_true, decide_eq_true_eq,
    F.pedersenCommit_smul_generator_eq_iff] at hcoll
  rcases hcoll with ⟨hm, hlin⟩
  have hmul : ((ofBits openings.2.2 : ZMod (F.order d)) - ofBits openings.1.2) * α =
      (ofBits openings.1.1 : ZMod (F.order d)) - ofBits openings.2.1 := by
    linear_combination -hlin
  have hr : (ofBits openings.2.2 : ZMod (F.order d)) ≠ ofBits openings.1.2 := by
    intro hreq
    apply hm
    have hzero : ((ofBits openings.2.2 : ZMod (F.order d)) - ofBits openings.1.2) * α = 0 := by
      rw [sub_eq_zero.mpr hreq, zero_mul]
    exact sub_eq_zero.mp (hmul.symm.trans hzero)
  rw [pedersenExtractNat_cast hr, ← hmul, inv_mul_cancel_left₀ (sub_ne_zero.mpr hr)]

/-- Turn a Pedersen binding adversary into a discrete-logarithm adversary by running it on
`(d, encode (α • g))` and extracting `pedersenExtractNat` in binary. -/
def pedersenToDLAdversary
    (adversary : ℕ → F.Desc × List Bool →
      ProbComp ((List Bool × List Bool) × (List Bool × List Bool)))
    (n : ℕ) (input : F.Desc × List Bool) : ProbComp (List Bool) := do
  let openings ← adversary n input
  return (pedersenExtractNat (F.order input.1)
    (ofBits openings.1.1) (ofBits openings.1.2)
    (ofBits openings.2.1) (ofBits openings.2.2)).bits

/-- **Exact binding-to-discrete-logarithm reduction**: for every security parameter `n`, the
success probability of `adversary` in `pedersenBindingGame` is at most the discrete-logarithm
success probability of `pedersenToDLAdversary adversary`. -/
theorem succProbability_pedersenBindingGame_le_discreteLogGame (setup : ℕ → PMF F.Desc)
    (adversary : ℕ → F.Desc × List Bool →
      ProbComp ((List Bool × List Bool) × (List Bool × List Bool)))
    (n : ℕ) :
    Game.succProbability (F.pedersenBindingGame setup adversary n) ≤
      Game.succProbability (F.discreteLogGame setup (F.pedersenToDLAdversary adversary) n) := by
  refine ENNReal.toNNReal_mono (PMF.apply_ne_top _ _) ?_
  dsimp only [pedersenBindingGame, discreteLogGame, pedersenToDLAdversary,
    PMF.monad_bind_eq_bind, PMF.monad_pure_eq_pure]
  simp only [ProbComp.eval_bind, ProbComp.eval_pure, PMF.bind_bind, PMF.pure_bind]
  refine PMF.bind_apply_mono_on_support (setup n) true fun d _ => ?_
  refine PMF.bind_apply_mono_on_support (PMF.uniformOfFintype (ZMod (F.order d))) true fun α _ => ?_
  refine PMF.bind_apply_mono_on_support
    (ProbComp.eval (adversary n (d, F.encode d (α • F.generator d)))) true fun openings _ => ?_
  by_cases hcoll : F.checkPedersenCollision d (α • F.generator d) openings = true
  · have hextract := F.pedersenExtractNat_eq_of_checkPedersenCollision d α hcoll
    have hbits : ((ofBits (pedersenExtractNat (F.order d)
        (ofBits openings.1.1) (ofBits openings.1.2)
        (ofBits openings.2.1) (ofBits openings.2.2)).bits : ℕ) : ZMod (F.order d)) = α := by
      unfold ofBits
      rwa [Nat.foldr_bit_bits]
    simp [hcoll, hbits]
  · simp [Bool.eq_false_iff.mpr hcoll]

private theorem computableTidilyInPolyTime_pedersenExtractNat {α : Type} {input : α ↪ List Bool}
    {d : α → F.Desc} {m₀ r₀ m₁ r₁ : α → ℕ}
    (hd : ComputableTidilyInPolyTime d input F.encDesc)
    (hm₀ : ComputableTidilyInPolyTime m₀ input encNat)
    (hr₀ : ComputableTidilyInPolyTime r₀ input encNat)
    (hm₁ : ComputableTidilyInPolyTime m₁ input encNat)
    (hr₁ : ComputableTidilyInPolyTime r₁ input encNat) :
    ComputableTidilyInPolyTime
      (fun a => pedersenExtractNat (F.order (d a)) (m₀ a) (r₀ a) (m₁ a) (r₁ a))
      input encNat := by
  have hq : ComputableTidilyInPolyTime (fun a => F.order (d a)) input encNat :=
    F.computableInPolyTime_order.tidy.comp hd
  have hdiff {x y : α → ℕ} (hx : ComputableTidilyInPolyTime x input encNat)
      (hy : ComputableTidilyInPolyTime y input encNat) :
      ComputableTidilyInPolyTime
        (fun a => (x a % F.order (d a) + F.order (d a) - y a % F.order (d a)) % F.order (d a))
        input encNat :=
    .binary_mod' (.binary_sub' (.binary_add' (.binary_mod' hx hq) hq) (.binary_mod' hy hq)) hq
  have hpow := (ComputableInPolyTime.binary_powMod (ComputableInPolyTime.of_tidy (hdiff hr₁ hr₀))
    (ComputableInPolyTime.of_tidy (.binary_sub' hq (.const 2)))
    (ComputableInPolyTime.of_tidy hq) fun a => (F.prime_order (d a)).pos).tidy
  exact .binary_mod' (.binary_mul' hpow (hdiff hm₀ hm₁)) hq

attribute [local fun_prop] computableTidilyInPolyTime_pedersenExtractNat

/-- `pedersenToDLAdversary` is uniform strict PPT whenever the binding adversary is. -/
theorem isPPTOn_pedersenToDLAdversary
    {adversary : ℕ → F.Desc × List Bool →
      ProbComp ((List Bool × List Bool) × (List Bool × List Bool))}
    (hA : IsPPTOn (encPair encUnary (encPair F.encDesc encBits))
      (encPair (encPair encBits encBits) (encPair encBits encBits))
      (fun input => adversary input.1 input.2)) :
    IsPPTOn (encPair encUnary (encPair F.encDesc encBits)) encBits
      (fun input => F.pedersenToDLAdversary adversary input.1 input.2) := by
  unfold pedersenToDLAdversary
  refine hA.bind_with ?_
  have hextract : ComputableTidilyInPolyTime
      (fun p : (ℕ × F.Desc × List Bool) × ((List Bool × List Bool) × (List Bool × List Bool)) =>
        (pedersenExtractNat (F.order p.1.2.1)
          (ofBits p.2.1.1) (ofBits p.2.1.2)
          (ofBits p.2.2.1) (ofBits p.2.2.2)).bits)
      (encPair (encPair encUnary (encPair F.encDesc encBits))
        (encPair (encPair encBits encBits) (encPair encBits encBits)))
      encBits := by
    change ComputableTidilyInPolyTime
      (fun p : (ℕ × F.Desc × List Bool) × ((List Bool × List Bool) × (List Bool × List Bool)) =>
        encNat (pedersenExtractNat (F.order p.1.2.1)
          (ofBits p.2.1.1) (ofBits p.2.1.2)
          (ofBits p.2.2.1) (ofBits p.2.2.2)))
      _ encBits
    exact ComputableTidilyInPolyTime.id'.comp (by fun_prop)
  exact hextract.isPPTOn

/-- **Computational binding of Pedersen commitments under the discrete-logarithm assumption**
([Pedersen1991], Theorem 3.1): if `F.DiscreteLog setup` holds, every uniform strict PPT adversary
succeeds in `pedersenBindingGame` with negligible probability. -/
theorem DiscreteLog.pedersenBinding {F : PrimeOrderGroupFamily} {setup : ℕ → PMF F.Desc}
    (hDL : F.DiscreteLog setup)
    (adversary : ℕ → F.Desc × List Bool →
      ProbComp ((List Bool × List Bool) × (List Bool × List Bool)))
    (hA : IsPPTOn (encPair encUnary (encPair F.encDesc encBits))
      (encPair (encPair encBits encBits) (encPair encBits encBits))
      (fun input => adversary input.1 input.2)) :
    Negligible fun n => Game.succProbability (F.pedersenBindingGame setup adversary n) :=
  negligible_of_le (hDL (F.pedersenToDLAdversary adversary) (F.isPPTOn_pedersenToDLAdversary hA))
    (F.succProbability_pedersenBindingGame_le_discreteLogGame setup adversary)

end Cslib.Crypto.PrimeOrderGroupFamily
