import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.NaorReingold
import Complexity.Crypto.Negligible.Basic
import Complexity.Tactic.PPT
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for the Naor–Reingold PRF and Multi-DDH (I)

Concrete checks on the Schnorr group `d23` of order `11` in `(ZMod 23)ˣ` generated by `2` for:
* word-level Naor–Reingold evaluation (`naorReingoldWordEval`, `naorReingoldWordSuffix`) and
  augmented-tree equivalence (`naorReingoldTreeEval_eq_naorReingoldEval`),
* fixed-$u$ DDH rerandomization (`ddhFixedUWordRerandomize`, `ddhFixedURerandomizeLaw_real`,
  `ddhFixedURerandomizeLaw_ideal`) and Multi-DDH (I) (`multiDDHRerandomizeLaw_real`,
  `multiDDHRerandomizeLaw_ideal`, `advantage_multiDDH_le`), and
* the prefix-hybrid Naor–Reingold PRF security bounds (`advantage_naorReingold_le_sum`,
  `advantage_naorReingold_le_mul`, and `DDH.negligible_naorReingold_of_distinguisher`).
-/

namespace ComplexityTests.Crypto.NaorReingold

open Cslib Cslib.Probability Cslib.Crypto Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- On the all-`false` query `[false, false, false]`, `naorReingoldWordEval` with `α₀ = 3` returns
`2 ^ 3 mod 23 = 8`. -/
example :
    schnorrGroups.naorReingoldWordEval d23 3 [2, 5, 7] [false, false, false] = Nat.bits 8 := by
  decide

/-- On query `[true, false, true]` with `α₀ = 3` and `α = [2, 5, 7]`, the selected exponent product
is `3 · 2 · 7 = 42 ≡ 9 (mod 11)`, and `2 ^ 9 = 512 ≡ 6 (mod 23)`. -/
example :
    schnorrGroups.naorReingoldWordEval d23 3 [2, 5, 7] [true, false, true] = Nat.bits 6 := by
  decide

/-- Suffix evaluation starting from `u = 2 ^ 3 = 8` along `αs = [2, 5, 7]` and
`xs = [true, false, true]` yields `8 ^ (2 · 7) = 8 ^ 3 = 512 ≡ 6 (mod 23)`. -/
example :
    schnorrGroups.naorReingoldWordSuffix d23 (Nat.bits 8) [2, 5, 7] [true, false, true] =
      Nat.bits 6 := by
  decide

/-- Fixed-$u$ word rerandomization on the real DDH triple
`(u, v, w) = (2^3, 2^5, 2^{15}) = (8, 9, 16)` with `(σ, τ) = (2, 1)` gives exponent
`σ + τ · β = 2 + 5 = 7`, so `v* = 2 ^ 7 mod 23 = 13` and `w* = 2 ^ 21 ≡ 2 ^ 10 mod 23 = 12`. -/
example :
    schnorrGroups.ddhFixedUWordRerandomize d23 (Nat.bits 8) (Nat.bits 9) (Nat.bits 16) 2 1 =
      (Nat.bits 13, Nat.bits 12) := by
  decide

/-- Concrete instantiation of Exercise 10.4(a): augmented-tree evaluation coincides with closed-form
Naor–Reingold evaluation on `d23`. -/
example (α₀ : ZMod (schnorrGroups.order d23)) (α : Fin 3 → ZMod (schnorrGroups.order d23))
    (x : BitString 3) :
    schnorrGroups.naorReingoldTreeEval d23 α₀ α x =
      schnorrGroups.naorReingoldEval d23 α₀ α x :=
  schnorrGroups.naorReingoldTreeEval_eq_naorReingoldEval d23 α₀ α x

/-- Concrete instantiation of Exercise 10.8(a) on `d23` with `(α, β) = (3, 5)`. -/
example :
    let α : ZMod (schnorrGroups.order d23) := 3
    let β : ZMod (schnorrGroups.order d23) := 5
    schnorrGroups.ddhFixedURerandomizeLaw d23 (α • schnorrGroups.generator d23)
      (β • schnorrGroups.generator d23) ((α * β) • schnorrGroups.generator d23) =
        schnorrGroups.ddhFixedURealLaw d23 α :=
  schnorrGroups.ddhFixedURerandomizeLaw_real d23 3 5

/-- Concrete instantiation of Exercise 10.8(b) on `d23` with non-DDH exponents `(3, 5, 7)`
(`7 ≠ 3 * 5` in `ZMod 11`). -/
example :
    let α : ZMod (schnorrGroups.order d23) := 3
    let β : ZMod (schnorrGroups.order d23) := 5
    let γ : ZMod (schnorrGroups.order d23) := 7
    schnorrGroups.ddhFixedURerandomizeLaw d23 (α • schnorrGroups.generator d23)
      (β • schnorrGroups.generator d23) (γ • schnorrGroups.generator d23) =
        schnorrGroups.ddhFixedUIdealLaw d23 :=
  schnorrGroups.ddhFixedURerandomizeLaw_ideal d23 (by decide)

/-- Concrete instantiation of Multi-DDH (I) real and ideal rerandomization on `d23` over index type
`BitString 3`. -/
example :
    let α : ZMod (schnorrGroups.order d23) := 3
    let β : ZMod (schnorrGroups.order d23) := 5
    let γ : ZMod (schnorrGroups.order d23) := 7
    schnorrGroups.multiDDHRerandomizeLaw d23 (BitString 3) (α • schnorrGroups.generator d23)
      (β • schnorrGroups.generator d23) ((α * β) • schnorrGroups.generator d23) =
        schnorrGroups.multiDDHRealTupleLaw d23 (BitString 3) α ∧
    schnorrGroups.multiDDHRerandomizeLaw d23 (BitString 3) (α • schnorrGroups.generator d23)
      (β • schnorrGroups.generator d23) (γ • schnorrGroups.generator d23) =
        schnorrGroups.multiDDHIdealTupleLaw d23 (BitString 3) :=
  ⟨schnorrGroups.multiDDHRerandomizeLaw_real d23 (BitString 3) 3 5,
    schnorrGroups.multiDDHRerandomizeLaw_ideal d23 (BitString 3) (by decide)⟩

open scoped Classical in
/-- An adaptive two-query distinguisher on `3`-bit strings over `d23`: it queries `0^3`, uses the
returned group element to choose a second query, and checks whether the two outputs match. -/
noncomputable def twoQueryDistinguisher :
    OracleComp (fun _ : BitString 3 => schnorrGroups.Carrier d23) Bool := do
  let y₀ ← OracleComp.query (fun _ : Fin 3 => false)
  let b := decide (y₀ = schnorrGroups.generator d23)
  let y₁ ← OracleComp.query (fun _ : Fin 3 => b)
  return decide (y₀ = y₁)

/-- Concrete instantiation of the `∑ k < 3` and common-bound Naor–Reingold PRF security reductions
on `d23` for `twoQueryDistinguisher`. -/
example :
    Game.advantage
      (schnorrGroups.naorReingoldRealGame d23 3 twoQueryDistinguisher)
      (schnorrGroups.naorReingoldIdealGame d23 3 twoQueryDistinguisher) ≤
    (∑ k ∈ Finset.range 3,
      Game.advantage
        ((schnorrGroups.ddhRealTupleLaw d23).bind
          (schnorrGroups.naorReingoldHopDDHDistinguisher d23 3 k twoQueryDistinguisher))
        ((schnorrGroups.ddhIdealTupleLaw d23).bind
          (schnorrGroups.naorReingoldHopDDHDistinguisher d23 3 k twoQueryDistinguisher))) +
      3 * (schnorrGroups.order d23 : ℝ≥0)⁻¹ :=
  schnorrGroups.advantage_naorReingold_le_sum d23 3 twoQueryDistinguisher

/-- `1 / 2 ^ n` is negligible. -/
theorem negligible_inv_two_pow : Negligible fun n => (1 / (2 ^ n : ℕ) : ℝ≥0) := by
  simpa only [Nat.cast_pow, Nat.cast_ofNat, one_div, inv_pow] using
    negligible_geometric (ratio := 2⁻¹) (by norm_num)

/-- Smoke-test instantiation of `DDH.negligible_naorReingold_of_distinguisher` for a trivial
non-querying adversary. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup) :
    Negligible fun n =>
      Game.advantage
        (schnorrGroups.naorReingoldSetupRealGame setup (fun _ _ => pure false) n)
        (schnorrGroups.naorReingoldSetupIdealGame setup (fun _ _ => pure false) n) := by
  refine hDDH.negligible_naorReingold_of_distinguisher
    (m := fun n => 2 ^ n) negligible_inv_two_pow (fun _ _ => pure false)
    (fun _ _ => pure false)
    (ComputableTidilyInPolyTime.isPPTOn (ComputableTidilyInPolyTime.const false))
    PolynomiallyBounded.id ?_
  intro n k _
  have hsame :
      schnorrGroups.naorReingoldSetupHybridGame setup (fun _ _ => pure false) n k =
        schnorrGroups.naorReingoldSetupHybridGame setup (fun _ _ => pure false) n (k + 1) := by
    unfold PrimeOrderGroupFamily.naorReingoldSetupHybridGame
    congr 1; funext d
    simp [PrimeOrderGroupFamily.naorReingoldHybridGame, PrimeOrderGroupFamily.evalWithFn]
  rw [hsame, Game.advantage_self]
  exact zero_le

end ComplexityTests.Crypto.NaorReingold
