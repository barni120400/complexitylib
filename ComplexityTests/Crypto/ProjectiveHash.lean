import Complexity.Crypto.Computational.CollisionResistant
import Complexity.Crypto.Computational.CramerShoup.ProjectiveHash
import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.Encryption.CCA
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for projective hash functions, 1CCA public-key security, and parameterized CRHF

Concrete checks on the Schnorr group of order `11` in `(ZMod 23)ˣ` generated by `2` for universal
and $\text{universal}_2$ projective hash bijections (`projHashEquiv`, `projHash2Equiv`), projective
evaluation on Diffie–Hellman triples, Lemma 12.5/12.7/12.8 probability formulas, the embedding of
IND-CPA adversaries into 1CCA (`CCA2Adversary.ofCPA`, `INDCCA2.indcpa`), and setup-parameterized
collision resistance (`CollisionResistantForOn`).
-/

namespace ComplexityTests.Crypto.ProjectiveHash

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.ProjectiveHash
open Cslib.Crypto.Encryption Turing.MultiTapeTM
open scoped ENNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- Concrete `decide` check for `projHashEquiv` on `ZMod 11 × ZMod 11` with
`α = 2, β = 3, γ = 7` (`7 ≠ 2 * 3 = 6`):
`(4 + 2 * 5, 3 * 4 + 7 * 5) = (14, 47) = (3, 3)` mod `11`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) ∧
      (projHashEquiv schnorrGroups d23 hγ).symm (3, 3) = (4, 5) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  have hf : (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply]⟩

/-- Concrete `decide` check for `projHash2Equiv` and its inverse on `ZMod 11` 4-tuples with
`α = 2, β = 3, γ = 7, β' = 4, γ' = 9, ρ = 1, ρ' = 5`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
    let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
    let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
    e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) ∧
      e.symm ((5, 0), (10, 9)) = ((1, 2), (3, 4)) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
  have hf : e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply]⟩

/-- Projective evaluation of `projHash` and `projHash2` on a Diffie–Hellman pair `(β • g, β • u)`
in `d23`. -/
example (σ₁ τ₁ σ₂ τ₂ β ρ : ZMod (schnorrGroups.order d23)) (u : schnorrGroups.Carrier d23) :
    projHash schnorrGroups d23 σ₁ τ₁ (β • schnorrGroups.generator d23) (β • u) =
      β • projHashAux schnorrGroups d23 σ₁ τ₁ u ∧
    projHash2 schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ ρ (β • schnorrGroups.generator d23) (β • u) =
      β • ((projHash2Aux schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ u).1 +
        ρ • (projHash2Aux schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ u).2) :=
  ⟨projHash_smul_generator schnorrGroups d23 σ₁ τ₁ β u,
    projHash2_smul_generator schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ β ρ u⟩

/-- Lemma 12.5 on `d23`: for the non-DH triple `(2 • g, 3 • g, 7 • g)` (`7 ≠ 2 * 3`), every joint
pair `(h, z)` has probability `((11 : ℝ≥0∞) ^ 2)⁻¹`. -/
example (h z : schnorrGroups.Carrier d23) :
    ((PMF.uniformOfFintype
      (ZMod (schnorrGroups.order d23) × ZMod (schnorrGroups.order d23))).map (fun p =>
      (projHashAux schnorrGroups d23 p.1 p.2 ((2 : ZMod (schnorrGroups.order d23)) •
        schnorrGroups.generator d23),
        projHash schnorrGroups d23 p.1 p.2 ((3 : ZMod (schnorrGroups.order d23)) •
          schnorrGroups.generator d23)
          ((7 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23)))) (h, z) =
      ((schnorrGroups.order d23 : ℝ≥0∞) ^ 2)⁻¹ := by
  have hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  exact uniform_projHash_apply_of_ne schnorrGroups d23 hγ h z

/-- Lemma 12.8 single-query conditional hit probability on `d23`: conditioned on `(δ₁, δ₂, ξ)`,
the query value `projHash2` on a non-DH triple with tag `ρ' = 5 ≠ 1 = ρ` hits any target `z'`
with probability `(11 : ℝ≥0∞)⁻¹`. -/
example (δ₁ δ₂ ξ : ZMod (schnorrGroups.order d23)) (z' : schnorrGroups.Carrier d23) :
    let α : ZMod (schnorrGroups.order d23) := 2
    let β' : ZMod (schnorrGroups.order d23) := 4
    let γ' : ZMod (schnorrGroups.order d23) := 9
    let ρ : ZMod (schnorrGroups.order d23) := 1
    let ρ' : ZMod (schnorrGroups.order d23) := 5
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).map (fun τ₂ =>
      projHash2 schnorrGroups d23 (δ₁ - α * (ξ - ρ * τ₂)) (ξ - ρ * τ₂) (δ₂ - α * τ₂) τ₂ ρ'
        (β' • schnorrGroups.generator d23) (γ' • schnorrGroups.generator d23))) z' =
      (schnorrGroups.order d23 : ℝ≥0∞)⁻¹ := by
  have hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  have hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  exact uniform_projHash2_fiber_apply schnorrGroups d23 hγ' hρ δ₁ δ₂ ξ z'

/-- `INDCCA2` implies `INDCPA` for any public-key bit encryption scheme
`(keyGen, encrypt, decrypt)`. -/
example (keyGen : ℕ → ProbComp (List Bool × List Bool))
    (encrypt : ℕ → List Bool → Bool → ProbComp (List Bool))
    (decrypt : ℕ → List Bool → List Bool → Option Bool)
    (hCCA : INDCCA2 keyGen encrypt decrypt) :
    INDCPA keyGen encrypt :=
  hCCA.indcpa

/-- Concrete check of `isCollisionFor` and `collisionGameFor_unit_eq`. -/
example :
    isCollisionFor (Param := Unit) (Digest := fun _ => Bool)
      (fun _ _ m => m.headD false) (fun _ _ _ => true)
      4 () [true] [false, true] [false, false] = true := by
  decide

example (H : List Bool → List Bool → List Bool)
    (valid : ℕ → List Bool → Bool) (adversary : CollisionFinder) (n : ℕ) :
    collisionGameFor (Param := Unit) (Digest := fun _ => List Bool)
      (fun _ => PMF.pure ()) (fun _ => H) (fun m _ => valid m)
      (fun m p => adversary m p.2) n =
      ProbComp.eval (collisionGame H valid adversary n) :=
  collisionGameFor_unit_eq H valid adversary n

end ComplexityTests.Crypto.ProjectiveHash
