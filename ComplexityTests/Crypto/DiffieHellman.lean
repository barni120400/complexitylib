import Complexity.Crypto.Computational.DiscreteLog.SchnorrGroup
import Complexity.Crypto.Computational.DiffieHellman
import Complexity.Crypto.Computational.ElGamal
import Complexity.Crypto.Negligible.Basic
import Complexity.Probability.PMF
import Complexity.Tactic.PPT
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for CDH, DDH, and ElGamal encryption

Concrete checks on the Schnorr group of order `11` in `(ZMod 23)ˣ` generated by `2` for encoded
ElGamal bit encoding and decryption, instantiations of `DL ≤ CDH ≤ DDH`, DDH random
self-reducibility, and ElGamal IND-CPA security under DDH.
-/

namespace ComplexityTests.Crypto.DiffieHellman

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM
open scoped NNReal Cslib.Probability.PMF

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- `false` encodes as the identity residue `1` in `(ZMod 23)ˣ`, and `true` as the generator `2`. -/
example : schnorrGroups.encodeBit d23 false = Nat.bits 1 := by decide
example : schnorrGroups.encodeBit d23 true = Nat.bits 2 := by decide

/-- With secret key `α = 3` (`u = 2 ^ 3 = 8`) and randomness `β = 5` (`v = 2 ^ 5 = 9`,
`u ^ β = 8 ^ 5 = 16`), encrypting `true` (`m = 2`) gives `e = 16 · 2 % 23 = 9`, and
`decodeElGamal` recovers `Nat.bits 2`. -/
example : schnorrGroups.decodeElGamal (d23, 3, Nat.bits 9, Nat.bits 9) = Nat.bits 2 := by decide

/-- Encrypting `false` (`m = 1`) with the same `(α = 3, β = 5)` gives `e = 16 · 1 % 23 = 16`, and
`decodeElGamal` recovers `Nat.bits 1`. -/
example : schnorrGroups.decodeElGamal (d23, 3, Nat.bits 9, Nat.bits 16) = Nat.bits 1 := by decide

/-- Word-level public-key derivation and encryption on `d23` with `(a = 3, b = 5)` and message
`Nat.bits 2` produce `(Nat.bits 9, Nat.bits 9)` and round-trip through `decodeElGamal`. -/
example : schnorrGroups.encodeElGamalPublicKey (d23, 3) = Nat.bits 8 := by decide
example :
    schnorrGroups.encodeElGamalEncrypt
      (d23, schnorrGroups.encodeElGamalPublicKey (d23, 3), Nat.bits 2, 5) =
      (Nat.bits 9, Nat.bits 9) := by decide

/-- Word-level Hashed ElGamal encryption and decryption on `d23` with `(a = 3, b = 5)` and 5-bit
message `[true, false, true, false, true]` under `Prod.snd` round-trip to
`[true, false, true, false, true]`. -/
example :
    let pk := schnorrGroups.encodeElGamalPublicKey (d23, 3)
    let m := [true, false, true, false, true]
    let ct := schnorrGroups.encodeHashedElGamalEncrypt Prod.snd (d23, pk, m, 5)
    schnorrGroups.decodeHashedElGamal Prod.snd (d23, 3, ct.1, ct.2) = m := by decide

/-- Word-level DDH re-randomization on `d23` with `(r, s₁, s₂) = (2, 1, 4)` evaluates
`encodeDDHRerandomize` on encoded group elements. -/
example :
    schnorrGroups.encodeDDHRerandomize
      (d23, (Nat.bits 8, Nat.bits 9, Nat.bits 16), 2, 1, 4) =
      (Nat.bits 13, Nat.bits 6, Nat.bits 3) := by decide

/-- Concrete instantiation of `dist_sampleModZModLaw_le` on `d23` at `n = 4`: the total-variation
distance between `PMF.uniformOfFintype (ZMod 11)` and `sampleModZModLaw 4 d23` is at most
`1 / 2 ^ 4`. -/
example :
    dist (PMF.uniformOfFintype (ZMod (schnorrGroups.order d23)))
      (schnorrGroups.sampleModZModLaw 4 d23) ≤ 1 / 2 ^ 4 :=
  schnorrGroups.dist_sampleModZModLaw_le 4 d23

/-- A trivial IND-CPA adversary that chooses `(false, true)` with empty saved state and outputs
`false`. -/
noncomputable def trivialAdversary : Encryption.Adversary where
  choose _ _ := pure ((false, true), [])
  guess _ _ _ := pure false

/-- `trivialAdversary` is uniform strict PPT. -/
theorem trivialAdversary_isPPT : trivialAdversary.IsPPT where
  choose := ComputableTidilyInPolyTime.isPPTOn (ComputableTidilyInPolyTime.const _)
  guess := ComputableTidilyInPolyTime.isPPTOn (ComputableTidilyInPolyTime.const _)

/-- For every Schnorr group description `d`, the identity `0 : schnorrGroups.Carrier d` (residue `1`
modulo `p`) is encoded by `(1 : ℕ).bits`. -/
theorem schnorrGroups_encode_zero (d : schnorrGroups.Desc) :
    schnorrGroups.encode d 0 = (1 : ℕ).bits := by
  change ((((1 : Subgroup.zpowers (SchnorrGroup.generatorUnit d)) : (ZMod d.1.1)ˣ) :
    ZMod d.1.1).val).bits = (1 : ℕ).bits
  rw [Subgroup.coe_one, Units.val_one, ZMod.val_one_eq_one_mod,
    Nat.mod_eq_of_lt d.2.prime_modulus.one_lt]

/-- From an encoded public key `encPair schnorrGroups.encDesc encBits (d, u)`, `dropFrame (dropFrame
(unframe pk))` extracts the encoded generator `d.1.2.2.bits = schnorrGroups.encode d (generator d)`.
-/
theorem dropFrame_dropFrame_unframe_encPair_encDesc (d : schnorrGroups.Desc) (u : List Bool) :
    dropFrame (dropFrame (unframe (encPair schnorrGroups.encDesc encBits (d, u)))) =
      schnorrGroups.encode d (schnorrGroups.generator d) := by
  have h1 : encPair schnorrGroups.encDesc encBits (d, u) =
      frame (frame d.1.1.bits ++ (frame d.1.2.1.bits ++ d.1.2.2.bits)) ++ u := rfl
  rw [h1, unframe_frame_append, dropFrame_frame_append, dropFrame_frame_append]
  exact (SchnorrGroup.encode_generator d).symm

/-- A word-message IND-CPA adversary that extracts the encoded generator `g` from the group
description in the public key `pk`, chooses `(encode d 0, encode d g)`, and tests whether the second
component of the ciphertext equals `encode d 0 = (1 : ℕ).bits`. -/
noncomputable def groupWordAdversary : Encryption.WordAdversary where
  choose _ pk := pure (((1 : ℕ).bits, dropFrame (dropFrame (unframe pk))), [])
  guess _ _ ct := pure (decide (dropFrame ct = (1 : ℕ).bits))

/-- `groupWordAdversary` is uniform strict PPT. -/
theorem groupWordAdversary_isPPT : groupWordAdversary.IsPPT where
  choose := by
    have hunf : ComputableTidilyInPolyTime unframe encBits encBits :=
      ComputableTidilyInPolyTime.of_linear (.of_unframe fun _ => rfl)
    have hdrop : ComputableTidilyInPolyTime dropFrame encBits encBits :=
      ComputableTidilyInPolyTime.of_linear (.of_dropFrame fun _ => rfl)
    have hg : ComputableTidilyInPolyTime
        (fun p : ℕ × List Bool => dropFrame (dropFrame (unframe p.2)))
        (encPair encUnary encBits) encBits :=
      hdrop.comp (hdrop.comp (hunf.comp (ComputableTidilyInPolyTime.snd _ _)))
    exact (((ComputableTidilyInPolyTime.const (1 : ℕ).bits).prod hg).prod
      (ComputableTidilyInPolyTime.const ([] : List Bool))).isPPTOn
  guess := by
    have hdrop : ComputableTidilyInPolyTime dropFrame encBits encBits :=
      ComputableTidilyInPolyTime.of_linear (.of_dropFrame fun _ => rfl)
    have hct : ComputableTidilyInPolyTime
        (fun p : ℕ × List Bool × List Bool => dropFrame p.2.2)
        (encPair encUnary (encPair encBits encBits)) encBits :=
      hdrop.comp ((ComputableTidilyInPolyTime.snd _ _).comp (ComputableTidilyInPolyTime.snd _ _))
    exact (ComputableTidilyInPolyTime.decide_eq' (encB := encBits) hct
      (ComputableTidilyInPolyTime.const (1 : ℕ).bits)).isPPTOn

/-- Under DDH for any setup law `setup`, `groupWordAdversary` has negligible advantage in the
group-element ElGamal IND-CPA game, because its chosen messages `(1 : ℕ).bits` and
`dropFrame (dropFrame (unframe pk))` decode to `0` and `generator d` in every Schnorr group `d`. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup) :
    Negligible fun n =>
      Game.advantage
        (schnorrGroups.elGamalGroupCPAGame setup groupWordAdversary false n)
        (schnorrGroups.elGamalGroupCPAGame setup groupWordAdversary true n) := by
  refine hDDH.negligible_elGamalGroupCPAGame groupWordAdversary_isPPT
    (Filter.Eventually.of_forall fun n d _ α choice hchoice => ?_)
  have hch : choice =
      (((1 : ℕ).bits,
        dropFrame (dropFrame (unframe
          (encPair schnorrGroups.encDesc encBits
            (d, schnorrGroups.encode d (α • schnorrGroups.generator d)))))), []) := by
    simpa only [groupWordAdversary, ProbComp.eval_pure, PMF.support_pure, Set.mem_singleton_iff]
      using hchoice
  rw [hch]
  exact ⟨⟨0, (schnorrGroups_encode_zero d).symm⟩,
    ⟨schnorrGroups.generator d, dropFrame_dropFrame_unframe_encPair_encDesc d
      (schnorrGroups.encode d (α • schnorrGroups.generator d))⟩⟩

/-- A word-message IND-CPA adversary that chooses 2-bit message words
`([false, false], [true, true])` with empty saved state and uses `groupWordAdversary.guess`. -/
noncomputable def hashedWordAdversary : Encryption.WordAdversary where
  choose _ _ := pure (([false, false], [true, true]), [])
  guess := groupWordAdversary.guess

/-- `hashedWordAdversary` is uniform strict PPT. -/
theorem hashedWordAdversary_isPPT : hashedWordAdversary.IsPPT where
  choose := ComputableTidilyInPolyTime.isPPTOn (ComputableTidilyInPolyTime.const _)
  guess := groupWordAdversary_isPPT.guess

/-- Degenerate `msgLen = 0` smoke test for `SecureKDF`: the 0-bit constant KDF `fun _ => []` has
identical real and ideal KDF games (`kdfRealGame = kdfIdealGame`) and therefore advantage `0`. -/
theorem secureKDF_nil (setup : ℕ → PMF schnorrGroups.Desc) :
    schnorrGroups.SecureKDF setup (fun _ => []) (fun _ => 0) := by
  intro distinguisher _
  have heq : ∀ n, schnorrGroups.kdfRealGame setup (fun _ => []) distinguisher n =
      schnorrGroups.kdfIdealGame setup (fun _ => 0) distinguisher n := by
    intro n
    simp only [PrimeOrderGroupFamily.kdfRealGame, PrimeOrderGroupFamily.kdfIdealGame,
      BitString.uniformList_zero, PMF.monad_bind_eq_bind, PMF.pure_bind, PMF.bind_const]
  simpa only [heq, Game.advantage_self] using negligible_zero

/-- Degenerate `msgLen = 0` smoke-test instantiation of `DDH.negligible_hashedElGamalCPAGame` using
`secureKDF_nil`. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup) :
    Negligible fun n =>
      Game.advantage
        (schnorrGroups.hashedElGamalCPAGame setup (fun _ => []) hashedWordAdversary false n)
        (schnorrGroups.hashedElGamalCPAGame setup (fun _ => []) hashedWordAdversary true n) :=
  hDDH.negligible_hashedElGamalCPAGame (secureKDF_nil setup) (by fun_prop) hashedWordAdversary_isPPT

/-- Under average-case DDH, the word-level re-randomization `ddhRerandomizeGame` of any real DDH
tuple family `(α d • g, β d • g, (α d * β d) • g)` and non-DDH tuple family
`(α' d • g, β' d • g, γ' d • g)` (`γ' d ≠ α' d * β' d`) is indistinguishable. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup)
    (α β α' β' γ' : (d : schnorrGroups.Desc) → ZMod (schnorrGroups.order d))
    (hγ' : ∀ᶠ n in Filter.atTop, ∀ d ∈ (setup n).support, γ' d ≠ α' d * β' d) :
    Game.Indistinguishable
      (schnorrGroups.ddhRerandomizeGame setup
        (fun d => (α d • schnorrGroups.generator d, β d • schnorrGroups.generator d,
          (α d * β d) • schnorrGroups.generator d)))
      (schnorrGroups.ddhRerandomizeGame setup
        (fun d => (α' d • schnorrGroups.generator d, β' d • schnorrGroups.generator d,
          γ' d • schnorrGroups.generator d)))
      fun distinguisher =>
        IsPPTOn
          (encPair encUnary
            (encPair schnorrGroups.encDesc (encPair encBits (encPair encBits encBits))))
          encBool (fun input => distinguisher input.1 input.2) :=
  hDDH.ddhRerandomizeGame α β α' β' γ' hγ'

/-- Concrete quantitative single-invocation bound `advantage_ddhRealGame_le_ddhWorstCaseGame` on
`d23` at `n = 4` with non-zero exponents `(α, β) = (3, 5)` and `(α', β', γ') = (3, 5, 7)` in
`ZMod 11` (`3 * 5 = 4 ≠ 7`). -/
example
    (distinguisher : ℕ → schnorrGroups.Desc × List Bool × List Bool × List Bool → ProbComp Bool) :
    Game.advantage (schnorrGroups.ddhRealGame (fun _ => PMF.pure d23) distinguisher 4)
      (schnorrGroups.ddhIdealGame (fun _ => PMF.pure d23) distinguisher 4) ≤
      Game.advantage
        (schnorrGroups.ddhWorstCaseGame (fun _ => PMF.pure d23)
          (fun d => ((3 : ZMod (schnorrGroups.order d)) • schnorrGroups.generator d,
            (5 : ZMod (schnorrGroups.order d)) • schnorrGroups.generator d,
            ((3 : ZMod (schnorrGroups.order d)) * 5) • schnorrGroups.generator d))
          (schnorrGroups.ddhSelfReduceDistinguisher distinguisher) 4)
        (schnorrGroups.ddhWorstCaseGame (fun _ => PMF.pure d23)
          (fun d => ((3 : ZMod (schnorrGroups.order d)) • schnorrGroups.generator d,
            (5 : ZMod (schnorrGroups.order d)) • schnorrGroups.generator d,
            (7 : ZMod (schnorrGroups.order d)) • schnorrGroups.generator d))
          (schnorrGroups.ddhSelfReduceDistinguisher distinguisher) 4) +
      (6 / 2 ^ 4 : ℝ≥0) := by
  refine schnorrGroups.advantage_ddhRealGame_le_ddhWorstCaseGame
    (fun _ => PMF.pure d23) (fun _ => 3) (fun _ => 5) (fun _ => 3) (fun _ => 5) (fun _ => 7)
    distinguisher 4 ?_
  intro d hd
  have hd23 : d = d23 := by simpa using hd
  subst hd23
  decide

/-- Worst-case-to-average-case DDH via `ddh_of_worstCase` over abstract DH/non-DH exponent families
`α, β, α', β', γ'`, with the modular exponent sampling error bounded internally by
`advantage_ddhRerandomizeGame_ddhWorstCaseGame_le`. -/
example (setup : ℕ → PMF schnorrGroups.Desc)
    (α β α' β' γ' : (d : schnorrGroups.Desc) → ZMod (schnorrGroups.order d))
    (hγ' : ∀ᶠ n in Filter.atTop, ∀ d ∈ (setup n).support, γ' d ≠ α' d * β' d)
    (hworst : Game.Indistinguishable
      (schnorrGroups.ddhWorstCaseGame setup
        (fun d => (α d • schnorrGroups.generator d,
          β d • schnorrGroups.generator d,
          (α d * β d) • schnorrGroups.generator d)))
      (schnorrGroups.ddhWorstCaseGame setup
        (fun d => (α' d • schnorrGroups.generator d,
          β' d • schnorrGroups.generator d,
          γ' d • schnorrGroups.generator d)))
      fun distinguisher =>
        IsPPTOn
          (encPair encUnary
            (encPair schnorrGroups.encDesc (encPair encBits (encPair encBits encBits))))
          encBool (fun input => distinguisher input.1 input.2)) :
    schnorrGroups.DDH setup :=
  schnorrGroups.ddh_of_worstCase α β α' β' γ' hγ' hworst

/-- `1 / 2 ^ n` is negligible. -/
theorem negligible_inv_two_pow : Negligible fun n => (1 / (2 ^ n : ℕ) : ℝ≥0) := by
  simpa only [Nat.cast_pow, Nat.cast_ofNat, one_div, inv_pow] using
    negligible_geometric (ratio := 2⁻¹) (by norm_num)

/-- Under DDH for Schnorr groups of order at least `2 ^ n`, both CDH and DiscreteLog hold. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup)
    (hsize : ∀ n, ∀ d ∈ (setup n).support, 2 ^ n ≤ schnorrGroups.order d) :
    schnorrGroups.CDH setup ∧ schnorrGroups.DiscreteLog setup :=
  ⟨hDDH.cdh Nat.two_pow_pos hsize negligible_inv_two_pow,
    hDDH.discreteLog Nat.two_pow_pos hsize negligible_inv_two_pow⟩

/-- Under DDH for Schnorr groups, ElGamal bit encryption is IND-CPA secure, and in particular
`trivialAdversary` has negligible advantage. -/
example (setup : ℕ → PMF schnorrGroups.Desc) (hDDH : schnorrGroups.DDH setup) :
    Negligible fun n =>
      Game.advantage (schnorrGroups.elGamalCPAGame setup trivialAdversary false n)
        (schnorrGroups.elGamalCPAGame setup trivialAdversary true n) :=
  hDDH.elGamalINDCPA trivialAdversary trivialAdversary_isPPT

/-- Under DDH random self-reducibility on the concrete group `d23`, re-randomizing any real DDH
tuple with secret exponents `(α, β) = (3, 5)` yields the uniform real DDH tuple distribution. -/
example :
    let α : ZMod (schnorrGroups.order d23) := 3
    let β : ZMod (schnorrGroups.order d23) := 5
    schnorrGroups.ddhRerandomizeLaw d23 (α • schnorrGroups.generator d23)
      (β • schnorrGroups.generator d23) ((α * β) • schnorrGroups.generator d23) =
        schnorrGroups.ddhRealTupleLaw d23 :=
  schnorrGroups.ddhRerandomizeLaw_real d23 3 5

/-- Under DDH random self-reducibility for any Schnorr group, re-randomizing any candidate non-DDH
tuple `(α • g, β • g, γ • g)` with `γ ≠ α * β` yields the uniform ideal DDH tuple distribution. -/
example (d : schnorrGroups.Desc) {α β γ : ZMod (schnorrGroups.order d)} (hγ : γ ≠ α * β) :
    schnorrGroups.ddhRerandomizeLaw d (α • schnorrGroups.generator d)
      (β • schnorrGroups.generator d) (γ • schnorrGroups.generator d) =
        schnorrGroups.ddhIdealTupleLaw d :=
  schnorrGroups.ddhRerandomizeLaw_ideal d hγ

end ComplexityTests.Crypto.DiffieHellman
